{
  "name": "websocket-server",
  "version": "1.0.0",
  "description": "simple nodejs websocket-server",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && npm start\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoopereira/websocket-server.git"
  },
  "keywords": [
    "websocket",
    "node"
  ],
