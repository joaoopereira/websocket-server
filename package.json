  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joaoopereira/websocket-server/issues"
  },
  "homepage": "https://github.com/joaoopereira/websocket-server#readme",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "ws": "^8.18.3"
